{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@moteur/*": [
        "../remotion/src/*"
      ]
    },
    "baseUrl": ".",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "../remotion/src"
  ]
}
